# ===========================================
# Money App - Environment Variables Template
# ===========================================
# Copy this file to .env.local for local development
# For production, set these in Vercel Dashboard
# ===========================================

# -------------------------------------------
# NextAuth.js Authentication
# -------------------------------------------
# Your deployed app URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# OAuth Providers (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -------------------------------------------
# Admin Credentials (REQUIRED in production)
# -------------------------------------------
# NOTE: Do NOT use obvious usernames like "admin". Generate strong credentials.
# Generate a secure password: openssl rand -base64 24
ADMIN_USERNAME=replace-with-secure-username
ADMIN_PASSWORD=replace-with-very-strong-password

# -------------------------------------------
# Vercel Postgres Database
# -------------------------------------------
# Get these from Vercel Dashboard > Storage > Postgres
POSTGRES_URL=postgres://username:password@host:5432/database?sslmode=require
POSTGRES_PRISMA_URL=postgres://username:password@host:5432/database?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://username:password@host:5432/database?sslmode=require
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# -------------------------------------------
# AWS VM Configuration - Model Inference Server (Optional)
# -------------------------------------------
# HTTP endpoint for model deployment and management
AWS_VM_HTTP_ENDPOINT=http://your-aws-vm-ip:8080

# WebSocket endpoint for real-time model updates (optional - remove if using SSE)
AWS_VM_WS_ENDPOINT=ws://your-aws-vm-ip:8081

# API key for authenticating with AWS VM (generate: openssl rand -hex 32)
AWS_VM_API_KEY=your-secure-api-key-for-vm-communication

# Legacy URLs (for backwards compatibility)
AWS_VM_URL=http://your-aws-vm-ip:8080
AWS_VM_WS_URL=ws://your-aws-vm-ip:8081/ws

# -------------------------------------------
# Model Upload Configuration
# -------------------------------------------
# Maximum file size for model uploads (in bytes) - Default: 500MB
MAX_MODEL_FILE_SIZE=524288000

# Timeout for model upload operations (ms) - Default: 2 minutes
MODEL_UPLOAD_TIMEOUT=120000

# Number of retry attempts for failed uploads
MODEL_RETRY_ATTEMPTS=3

# Delay between retry attempts (ms)
MODEL_RETRY_DELAY=5000

# -------------------------------------------
# Realtime Transport Configuration (Vercel-friendly)
# -------------------------------------------
# Preferred transport: 'sse' (Server-Sent Events) or 'ws' for external WebSocket servers
NEXT_PUBLIC_WS_TRANSPORT=sse

# SSE endpoint for client connections (default to built-in API route)
NEXT_PUBLIC_SSE_URL=/api/ws

# If you host an external WebSocket server, set the following environment variables:
# NEXT_PUBLIC_WS_TRANSPORT=ws
# NEXT_PUBLIC_WS_URL=ws://your-external-ws-host:3001

# -------------------------------------------
# Internal API Security
# -------------------------------------------
# API key for internal service communication (used by AWS VM or other services)
# Generate a secure key: openssl rand -hex 32
INTERNAL_API_KEY=your-internal-api-key-here

# -------------------------------------------
# CORS Configuration
# -------------------------------------------
# Comma-separated list of allowed origins for CORS
# Leave empty to allow all origins, or specify domains
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app

# AWS VM origin (for WebSocket/API connections)
AWS_VM_ORIGIN=http://your-aws-vm-ip:port

# -------------------------------------------
# Application Settings
# -------------------------------------------
# App URL (used for generating links in client)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable debug logging
DEBUG=false

# Legacy WebSocket URL (deprecated, use AWS_VM_WS_URL)
WS_URL=
